views:
  - type: table
    name: 视图
    filters:
      and:
        - tag != "clipper"
        - '!file.name.endsWith("Template")'
        - file.name != "Welcome"
        - file.ext != "base"
        - '!file.path.startsWith("Diary")'
        - '!file.path.contains("Books")'
        - '!file.path.startsWith("copilot")'
        - '!file.name.contains("(Main)")'
        - '!file.name.contains("(MOC)")'
        - '!file.path.startsWith("images")'
    order:
      - file.name
      - type
      - sub-type
    sort:
      - property: file.mtime
        direction: DESC
    limit: 10
    image: note.cover
    cardSize: 240
    imageAspectRatio: 0.65
    columnSize:
      file.name: 360
      note.type: 456
      note.sub-type: 170
  - type: cards
    name: 视图 2
    filters:
      and:
        - finished == "false"
        - tag != "clipper"
    order:
      - file.name
      - file.mtime
    cardSize: 330
